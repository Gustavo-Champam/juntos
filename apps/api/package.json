{
  "name": "@juntos/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "npm --workspace @juntos/contracts run build",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretest": "npm --workspace @juntos/contracts run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@juntos/contracts": "0.1.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
